# GCP project — Firestore + Vertex AI auth via ADC (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=knotmem26

# Email notification — OPTIONAL (omit both to use CSV output only)
# NOTIFY_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD=your_16char_app_password  # myaccount.google.com/apppasswords

# Scoring thresholds (optional overrides)
# MATCH_SCORE_THRESHOLD=7.0
# PARTIAL_SCORE_THRESHOLD=4.0

# Admin UI password (local dev only — production reads from GCP Secret Manager)
# ADMIN_PASSWORD=your-password

# Public base URL — used in email notifications to link back to results
# BASE_URL=https://your-cloudrun-url.run.app
