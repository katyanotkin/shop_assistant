# GCP project (same as verbboard — Firestore + Vertex AI auth via ADC)
GOOGLE_CLOUD_PROJECT=knotmem26

# Google Custom Search API
# 1. Enable "Custom Search JSON API" at console.cloud.google.com/apis (project knotmem26)
# 2. Create or reuse an API key
GOOGLE_CUSTOM_SEARCH_API_KEY=your_api_key_here

# Programmable Search Engine ID
# Create at: https://programmablesearchengine.google.com/ — "Search the entire web" ON
SEARCH_ENGINE_ID=your_engine_id_here

# Email notification — OPTIONAL (omit both to use CSV output only)
# NOTIFY_EMAIL=you@gmail.com
# GMAIL_APP_PASSWORD=your_16char_app_password  # myaccount.google.com/apppasswords

# Scoring thresholds (optional overrides)
# MATCH_SCORE_THRESHOLD=7.0
# PARTIAL_SCORE_THRESHOLD=4.0
